exports[`SSR スナップショット > 税・保険の見積もり: 台帳の「 · 見積」「 · 手直し」、編集の注記と「自動計算に戻す」、見通しの月の「 · 見積」 1`] = `
[
  "<section class=\\"m-col\\" aria-labelledby=\\"m-ledger\\"><h2 id=\\"m-ledger\\" class=\\"m-h2 m-px4\\">台帳（次の期日順）</h2><div class=\\"m-chips6\\" role=\\"group\\" aria-label=\\"分類で絞り込む\\"><button type=\\"button\\" aria-pressed=\\"true\\">全部</button>",
  "<button type=\\"button\\" aria-pressed=\\"false\\">税金</button>",
  "<button type=\\"button\\" aria-pressed=\\"false\\">保険</button>",
  "<button type=\\"button\\" aria-pressed=\\"false\\">車</button>",
  "<button type=\\"button\\" aria-pressed=\\"false\\">積立</button>",
  "<button type=\\"button\\" aria-pressed=\\"false\\">その他</button>",
  "<button type=\\"button\\" aria-pressed=\\"false\\">収入</button>",
  "</div>",
  "<ul class=\\"m-ledger\\"><li><button type=\\"button\\" class=\\"m-lrow\\"><span class=\\"m-lrow-date\\"><b>11/30</b><span>あと 24 日</span></span><span class=\\"m-lrow-name\\"><span>国民年金 2026 年度（見積）</span><span><span class=\\"m-badge b-insurance\\">保険</span>毎月 · 見積</span></span><span class=\\"m-lrow-amt\\">17,510</span></button>",
  "</li>",
  "<li><button type=\\"button\\" class=\\"m-lrow\\"><span class=\\"m-lrow-date\\"><b>12/28</b><span>あと 52 日</span></span><span class=\\"m-lrow-name\\"><span>国民健康保険税 2026 年度 第 6 期（見積）</span><span><span class=\\"m-badge b-insurance\\">保険</span>1 回 · 見積</span></span><span class=\\"m-lrow-amt\\">51,500</span></button>",
  "</li>",
  "<li><button type=\\"button\\" class=\\"m-lrow\\"><span class=\\"m-lrow-date\\"><b>3/15</b><span>2027</span></span><span class=\\"m-lrow-name\\"><span>所得税 2026 年分 確定申告（見積）</span><span><span class=\\"m-badge b-tax\\">税金</span>1 回 · 見積 · 手直し</span></span><span class=\\"m-lrow-amt\\">120,000</span></button>",
  "</li>",
  "<li><button type=\\"button\\" class=\\"m-lrow\\"><span class=\\"m-lrow-date\\"><b>3/31</b><span>2027</span></span><span class=\\"m-lrow-name\\"><span>消費税 2026 年分 確定申告（見積）</span><span><span class=\\"m-badge b-tax\\">税金</span>1 回 · 見積</span></span><span class=\\"m-lrow-amt\\">200,000</span></button>",
  "</li>",
  "<li><button type=\\"button\\" class=\\"m-lrow\\"><span class=\\"m-lrow-date\\"><b>—</b><span>期日なし</span></span><span class=\\"m-lrow-name\\"><span>自動車税</span><span><span class=\\"m-badge b-car\\">車</span>毎年</span></span><span class=\\"m-lrow-amt\\">39,500</span></button>",
  "</li>",
  "</ul>",
  "</section>",
  "<section class=\\"m-card m-form\\" aria-labelledby=\\"m-item-form\\"><h2 id=\\"m-item-form\\" class=\\"m-h2\\">「国民健康保険税 2026 年度 第 6 期（見積）」を編集</h2><p class=\\"m-sub13\\">金額や日付を直すと、再計算で上書きされなくなります。</p>",
  "<div class=\\"m-seg m-seg-3\\" role=\\"group\\" aria-label=\\"向き\\"><button type=\\"button\\" aria-pressed=\\"true\\">支出</button>",
