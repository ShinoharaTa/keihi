exports[`SSR スナップショット（選択モード・一括） > 上の帯: スマホは「n 件選択中 ・ すべて選択 ・ 完了」、PC はチェック・件数・完了。絞り込み結果をすべて選択・直前の一括を元に戻す 1`] = `
[
  "<header class=\\"m-head m-head-flat m-selhead\\"><h1 aria-live=\\"polite\\">12 件選択中</h1><button type=\\"button\\" class=\\"m-btn\\">すべて選択</button>",
  "<button type=\\"button\\" class=\\"m-btn m-btn-primary\\">完了</button>",
  "</header>",
  "<div class=\\"m-selrow\\"><span class=\\"m-checkwrap\\"><input type=\\"checkbox\\" class=\\"m-check\\" aria-label=\\"すべて選択（見えている行）\\"></span><span class=\\"m-selrow-text\\" aria-live=\\"polite\\">12 件選択中</span><button type=\\"button\\" class=\\"m-btn\\">完了</button>",
  "</div>",
  "<div class=\\"m-selrow\\"><span class=\\"m-checkwrap\\"><input type=\\"checkbox\\" class=\\"m-check\\" aria-label=\\"すべて選択（見えている行）\\"></span><span class=\\"m-selrow-text\\" aria-live=\\"polite\\">すべて選択</span></div>",
  "<div class=\\"m-selrow\\"><span class=\\"m-checkwrap\\"><input type=\\"checkbox\\" class=\\"m-check\\" checked aria-label=\\"すべて選択（見えている行）\\"></span><span class=\\"m-selrow-text\\" aria-live=\\"polite\\">4 件選択中</span><button type=\\"button\\" class=\\"m-btn\\">完了</button>",
  "</div>",
  "<div class=\\"m-seltools\\"><button type=\\"button\\" class=\\"m-btn\\">絞り込み結果をすべて選択（50+ 件）</button>",
  "<button type=\\"button\\" class=\\"m-btn\\">直前の一括を元に戻す</button>",
  "<p class=\\"m-msg\\" role=\\"status\\">500 件までです。絞り込んでください。</p>",
  "</div>",
  "<div class=\\"m-seltools\\"><button type=\\"button\\" class=\\"m-btn\\" disabled>絞り込み結果をすべて選択（50+ 件）</button>",
  "</div>"
]
`;

