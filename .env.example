# keihi をコンテナで動かすときの環境変数（説明は DEPLOYMENT.md §3）。
# ここにあるのは例の値。本物の値はこのファイルに書かず、Coolify の Environment Variables に入れる。
# systemd で動かす従来の構成（~/.config/keihi/config.toml と secrets.env）では、このファイルは使わない。

# --- 必須: だれを・どのホスト名で通すか ---
KEIHI_WEB_AUTH=cloudflare_access
# VPN・LAN の内側だけで届く構成なら認証なしにもできる（KEIHI_WEB_ALLOWED_USERS はちょうど 1 件。DEPLOYMENT.md §8）
# KEIHI_WEB_AUTH=none
KEIHI_WEB_ACCESS_TEAM_DOMAIN=example.cloudflareaccess.com
# Access のアプリの「Application Audience (AUD) Tag」（64 桁の 16 進）
KEIHI_WEB_ACCESS_AUD=replace-with-aud-tag
KEIHI_WEB_ALLOWED_USERS=you@example.com
KEIHI_WEB_ALLOWED_HOSTS=keihi.example.com
# iOS ショートカットなど、ブラウザでログインできないクライアント用のサービストークンの Client ID（任意、カンマ区切り）
# KEIHI_WEB_ACCESS_SERVICE_TOKENS=0123456789abcdef0123456789abcdef.access

# --- シークレット（Coolify では「Runtime only」にする。ビルドには渡さない） ---
GEMINI_API_KEY=
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# --- 業務の設定（config.toml の [セクション] キー = KEIHI_<セクション>_<キー>） ---
# KEIHI_PROVIDER_KIND=freee
# KEIHI_FREEE_TARGET=poc
# KEIHI_FREEE_POC_COMPANY_ID=
# KEIHI_FREEE_PROD_COMPANY_ID=
# KEIHI_GEMINI_PAID_TIER_CONFIRMED=true
# KEIHI_CASHFLOW_INCLUDE_UNPLANNED_INCOME=false
# KEIHI_MAIL_ACCOUNTS=[{ id = "main", label = "keihi" }]

# --- ログ ---
LOG_LEVEL=info
LOG_FORMAT=json
APP_ENV=production
# SERVICE_NAME=keihi

# --- イメージが既定で設定しているもの（ふつうは変えない） ---
# KEIHI_DATA_DIR=/data
# KEIHI_CONFIG_DIR=/config
# KEIHI_BIND_HOST=0.0.0.0
# KEIHI_WORKER_MODE=spawn
# KEIHI_MIGRATE_ON_START=1
# DB の場所を /data/keihi.db 以外にするときだけ（SQLite だけに対応）
# DATABASE_URL=sqlite:///data/keihi.db
