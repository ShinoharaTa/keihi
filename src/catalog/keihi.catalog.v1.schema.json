{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keihi.catalog/v1",
  "title": "keihi.catalog/v1",
  "description": "確認カードと質問カードの部品カタログ（docs/a2ui-review-ui.md §2.1）。サーバーと PWA で共有する。カタログに無い部品・フィールドは描画しない。文字列は textContent でだけ描画する。allOf と $ref は使わない。",
  "type": "object",
  "properties": {
    "catalogId": {
      "type": "string",
      "enum": [
        "keihi.catalog/v1"
      ]
    },
    "surfaceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "anyOf": [
          {
            "description": "画像のサムネイル。画像は keihi のサーバーから document_id で取る（URL は持たない）",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "ReceiptThumb"
                ]
              },
              "document_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "id",
              "component",
              "document_id"
            ],
            "additionalProperties": false
          },
          {
            "description": "合計と税率の区分ごとの内訳",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "AmountField"
                ]
              },
              "total": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "by_rate": {
                "type": "array",
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "category": {
                      "type": "string",
                      "enum": [
                        "taxable_10",
                        "taxable_8_reduced",
                        "non_taxable",
                        "out_of_scope"
                      ]
                    },
                    "amount_incl_tax": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tax": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "category",
                    "amount_incl_tax",
                    "tax"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "component",
              "total",
              "by_rate"
            ],
            "additionalProperties": false
          },
          {
            "description": "取引日",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "DateField"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              }
            },
            "required": [
              "id",
              "component",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "description": "取引先名と登録番号（T + 13 桁）",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "VendorField"
                ]
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 100
              },
              "invoice_reg_no": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^T[0-9]{13}$"
              }
            },
            "required": [
              "id",
              "component",
              "name",
              "invoice_reg_no"
            ],
            "additionalProperties": false
          },
          {
            "description": "確信度の高い順に上位 3 件と「他の科目…」",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "AccountChips"
                ]
              },
              "candidates": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "account_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 32
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 40
                    },
                    "tax_id": {
                      "type": "string",
                      "enum": [
                        "taxable_10",
                        "taxable_8_reduced",
                        "non_taxable",
                        "out_of_scope"
                      ]
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "account_id",
                    "name",
                    "tax_id",
                    "confidence"
                  ],
                  "additionalProperties": false
                }
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 32
              }
            },
            "required": [
              "id",
              "component",
              "candidates",
              "selected"
            ],
            "additionalProperties": false
          },
          {
            "description": "検索付きのボトムシート。一覧は provider_masters（enabled_accounts）から引く",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "AccountSheet"
                ]
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 32
              }
            },
            "required": [
              "id",
              "component",
              "selected"
            ],
            "additionalProperties": false
          },
          {
            "description": "支払手段（事業主借 / 現金 / カード…）",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "PaymentChips"
                ]
              },
              "options": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "id",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "selected": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64
              }
            },
            "required": [
              "id",
              "component",
              "options",
              "selected"
            ],
            "additionalProperties": false
          },
          {
            "description": "確定 / 私用 / 重複 / 保留",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "DecisionBar"
                ]
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "enum": [
                    "approve",
                    "personal",
                    "duplicate",
                    "hold"
                  ]
                }
              }
            },
            "required": [
              "id",
              "component",
              "actions"
            ],
            "additionalProperties": false
          },
          {
            "description": "質問（選択肢 2〜4）。Gemini が questions[] で返す",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "ChoiceQuestion"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "effect": {
                      "description": "選んだら変わるもの。value は field ごとに制約する。account_id の値はサーバーがその時点の enabled_accounts で検証する",
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "enum": [
                                "account_id"
                              ]
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 32
                            }
                          },
                          "required": [
                            "field",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "enum": [
                                "tax_id"
                              ]
                            },
                            "value": {
                              "type": "string",
                              "enum": [
                                "taxable_10",
                                "taxable_8_reduced",
                                "non_taxable",
                                "out_of_scope"
                              ]
                            }
                          },
                          "required": [
                            "field",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "enum": [
                                "proration_pct"
                              ]
                            },
                            "value": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 100
                            }
                          },
                          "required": [
                            "field",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "enum": [
                                "decision"
                              ]
                            },
                            "value": {
                              "type": "string",
                              "enum": [
                                "approve",
                                "personal",
                                "duplicate",
                                "hold"
                              ]
                            }
                          },
                          "required": [
                            "field",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "field": {
                              "type": "string",
                              "enum": [
                                "memo_tag"
                              ]
                            },
                            "value": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 20
                            }
                          },
                          "required": [
                            "field",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  },
                  "required": [
                    "label",
                    "effect"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "component",
              "text",
              "options"
            ],
            "additionalProperties": false
          },
          {
            "description": "按分の質問（0〜100%、10% 刻み）",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "ProrationQuestion"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "min": {
                "type": "integer",
                "enum": [
                  0
                ]
              },
              "max": {
                "type": "integer",
                "enum": [
                  100
                ]
              },
              "step": {
                "type": "integer",
                "enum": [
                  10
                ]
              },
              "suggested": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            },
            "required": [
              "id",
              "component",
              "text",
              "min",
              "max",
              "step",
              "suggested"
            ],
            "additionalProperties": false
          },
          {
            "description": "はい / いいえの質問",
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "component": {
                "type": "string",
                "enum": [
                  "YesNoQuestion"
                ]
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "yes": {
                "description": "選んだら変わるもの。value は field ごとに制約する。account_id の値はサーバーがその時点の enabled_accounts で検証する",
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "account_id"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "tax_id"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "taxable_10",
                          "taxable_8_reduced",
                          "non_taxable",
                          "out_of_scope"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "proration_pct"
                        ]
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "decision"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "approve",
                          "personal",
                          "duplicate",
                          "hold"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "memo_tag"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "no": {
                "description": "選んだら変わるもの。value は field ごとに制約する。account_id の値はサーバーがその時点の enabled_accounts で検証する",
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "account_id"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 32
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "tax_id"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "taxable_10",
                          "taxable_8_reduced",
                          "non_taxable",
                          "out_of_scope"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "proration_pct"
                        ]
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 100
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "decision"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "enum": [
                          "approve",
                          "personal",
                          "duplicate",
                          "hold"
                        ]
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "field": {
                        "type": "string",
                        "enum": [
                          "memo_tag"
                        ]
                      },
                      "value": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 20
                      }
                    },
                    "required": [
                      "field",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            },
            "required": [
              "id",
              "component",
              "text",
              "yes",
              "no"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "catalogId",
    "surfaceId",
    "components"
  ],
  "additionalProperties": false
}
